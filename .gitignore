target
logs/
.env

# wasm-bindgen output for the islands crate (crates/islands) — built by the
# Dockerfile's wasm-builder stage, not committed.
pkg/

# terraform state holds resource attributes in plaintext, including the
# Keycloak client_secret output — must never be committed.
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/terraform.tfvars

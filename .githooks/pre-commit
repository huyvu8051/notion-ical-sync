#!/bin/bash
# Pre-commit hook to automatically format Rust code and stage the changes

echo "Running cargo fmt..."
cargo fmt --all

# Re-add any modified Rust files to the commit
STAGED_RS_FILES=$(git diff --name-only --cached --diff-filter=d | grep '\.rs$')

if [ -n "$STAGED_RS_FILES" ]; then
    echo "Re-staging formatted files..."
    echo "$STAGED_RS_FILES" | xargs git add
fi
